{
  "name": "todoer",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:plus": "cross-env CALENDAR_ENABLED=true vite",
    "build": "tsc && vite build",
    "build:plus": "cross-env CALENDAR_ENABLED=true tsc && cross-env CALENDAR_ENABLED=true vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:plus": "cross-env CALENDAR_ENABLED=true tauri dev --config src-tauri/tauri.conf.plus.json -- --features calendar",
    "tauri:build": "tauri build",
    "tauri:build:plus": "cross-env CALENDAR_ENABLED=true tauri build --config src-tauri/tauri.conf.plus.json -- --features calendar"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rrule": "^2.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
